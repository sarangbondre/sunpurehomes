# ─────────────────────────────────────────────────────────────────────────────
# Arka — the website assistant. See docs/adr/0002-arka.md.
#
# Every variable is optional. Without a model key, Arka tells visitors it
# can't answer right now and shows the sales contact buttons. Without an
# email key, the enquiry form does the same. The site never breaks.
#
# Values go in Vercel → Project → Settings → Environment Variables, or in a
# local .env.local (ignored by git). Never commit a real value to this file.
#
# BEFORE LAUNCH: set a spending limit with the model provider (Hugging Face
# billing, or the Anthropic workspace). That is the hard ceiling; the in-app
# rate limit is best-effort.
# ─────────────────────────────────────────────────────────────────────────────

# Which model answers: huggingface (default) | anthropic | openai-compatible
ARKA_PROVIDER=huggingface

# Hugging Face Inference Providers — the default. Create a fine-grained token
# at huggingface.co/settings/tokens with "Make calls to Inference Providers".
# Free accounts get about $0.10 of credit a month; buy credits for real traffic.
HF_TOKEN=

# The model, with its host pinned after the colon. Without a pin, Hugging Face
# routes each request to whichever host is fastest, so visitors could get a
# different model from the one the eval passed. Defaults to
# meta-llama/Llama-3.3-70B-Instruct:novita. Cheaper, weaker alternative:
# meta-llama/Llama-3.1-8B-Instruct:deepinfra. List what is served, and by
# whom, at https://router.huggingface.co/v1/models. Run `npm run eval:arka`
# before changing it.
ARKA_MODEL=

# For ARKA_PROVIDER=anthropic. From console.anthropic.com. Defaults to
# claude-haiku-4-5.
ANTHROPIC_API_KEY=

# For ARKA_PROVIDER=openai-compatible — any other host with a
# /chat/completions endpoint (Together, DeepInfra, Fireworks, Groq).
ARKA_OSS_BASE_URL=
ARKA_OSS_API_KEY=
ARKA_OSS_TEMPERATURE=0.2

# Limits. The defaults suit a short-answer assistant.
ARKA_MAX_TOKENS=500
ARKA_TIMEOUT_MS=20000

# ── Lead email ───────────────────────────────────────────────────────────────
# From resend.com. The sending domain must be verified there (DNS records on
# sunpurehomes.com), or messages will be refused or land in spam.
RESEND_API_KEY=

# The From line, on the verified domain.
LEAD_FROM=Arka <arka@sunpurehomes.com>

# Where leads go. Defaults to the sales address in src/lib/site.ts.
LEAD_INBOX=
