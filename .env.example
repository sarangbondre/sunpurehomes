# ─────────────────────────────────────────────────────────────────────────────
# Arka — the website assistant. See docs/adr/0002-arka.md.
#
# Every variable is optional. Without a model key, Arka tells visitors it
# can't answer right now and shows the sales contact buttons. Without an
# email key, the enquiry form does the same. The site never breaks.
#
# Values go in Vercel → Project → Settings → Environment Variables, or in a
# local .env.local (ignored by git). Never commit a real value to this file.
#
# BEFORE LAUNCH: set a monthly spend limit on the Anthropic workspace. That is
# the hard ceiling; the in-app rate limit is best-effort.
# ─────────────────────────────────────────────────────────────────────────────

# Which model answers: anthropic | openai-compatible
ARKA_PROVIDER=anthropic

# Defaults to claude-haiku-4-5 for anthropic. Required for openai-compatible,
# e.g. meta-llama/Llama-3.1-8B-Instruct — ids differ between hosts.
ARKA_MODEL=

# For ARKA_PROVIDER=anthropic. From console.anthropic.com.
ANTHROPIC_API_KEY=

# For ARKA_PROVIDER=openai-compatible — any host with a /chat/completions
# endpoint: Hugging Face, Together, DeepInfra, Fireworks, Groq. Run
# `npm run eval:arka` before switching visitors over.
#
# Hugging Face Inference Providers:
#   ARKA_OSS_BASE_URL=https://router.huggingface.co/v1
#   ARKA_OSS_API_KEY=<fine-grained token with "Make calls to Inference Providers">
#   ARKA_MODEL=meta-llama/Llama-3.1-8B-Instruct:groq
# Pin a provider with the suffix (":groq", ":cerebras"...). Without one,
# Hugging Face picks the fastest provider per request, so the model serving a
# visitor can differ from the one the eval passed on. Free accounts get about
# $0.10 of credit a month — buy credits for real traffic.
ARKA_OSS_BASE_URL=
ARKA_OSS_API_KEY=
ARKA_OSS_TEMPERATURE=0.2

# Limits. The defaults suit a short-answer assistant.
ARKA_MAX_TOKENS=500
ARKA_TIMEOUT_MS=20000

# ── Lead email ───────────────────────────────────────────────────────────────
# From resend.com. The sending domain must be verified there (DNS records on
# sunpurehomes.com), or messages will be refused or land in spam.
RESEND_API_KEY=

# The From line, on the verified domain.
LEAD_FROM=Arka <arka@sunpurehomes.com>

# Where leads go. Defaults to the sales address in src/lib/site.ts.
LEAD_INBOX=
